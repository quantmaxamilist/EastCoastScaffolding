---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import Hero from '../components/Hero.astro';
import InspectionTag from '../components/InspectionTag.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import CtaBand from '../components/CtaBand.astro';
import { homeGalleryPreview } from '../data/gallery';
import { homeServiceTeasers } from '../data/services';
import { testimonials } from '../data/testimonials';
import { townLine, trustPillars } from '../data/site';
---

<Layout>
  <PageShell>
    <Hero />

    <section class="section-padding bg-panel">
      <div class="container-narrow">
        <p class="eyebrow mb-3" data-reveal>On every job</p>
        <h2 class="mb-10 font-display text-3xl font-extrabold md:text-4xl" data-reveal>Competence you can check</h2>
        <div class="grid gap-6 md:grid-cols-3">
          {
            trustPillars.map((p, i) => (
              <div class="flex gap-4 border border-hairline bg-galvanised p-5" data-reveal>
                <InspectionTag
                  tagNumber={p.tagNumber}
                  header={p.header}
                  status={p.title}
                  date={p.date}
                  inspector="ECS"
                  variant={i === 1 ? 'amber' : i === 2 ? 'rust' : 'moss'}
                  class="hidden shrink-0 sm:block"
                />
                <div>
                  <h3 class="mb-2 font-display text-lg font-extrabold">{p.title}</h3>
                  <p class="text-sm leading-relaxed text-muted">{p.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-padding">
      <div class="container-narrow">
        <div class="mb-10 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="eyebrow mb-3" data-reveal>What we put up</p>
            <h2 class="font-display text-3xl font-extrabold md:text-4xl" data-reveal>Access, protection, design</h2>
          </div>
          <a href="/services" class="text-sm font-semibold text-rust hover:underline" data-reveal>All services</a>
        </div>
        <div class="grid gap-px bg-hairline sm:grid-cols-2 lg:grid-cols-4">
          {
            homeServiceTeasers.map((s) => (
              <a href={`/services#${s.slug}`} class="group bg-galvanised p-6 transition-colors hover:bg-panel" data-reveal>
                <span class="mb-4 inline-flex text-rust group-hover:text-ink">
                  <ServiceIcon name={s.slug} />
                </span>
                <h3 class="mb-2 font-display text-base font-extrabold">{s.title}</h3>
                <p class="text-sm leading-relaxed text-muted">{s.summary}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-ink py-4 text-white md:py-6">
      <div class="container-narrow overflow-hidden px-5 md:px-8 lg:px-12">
        <p class="whitespace-nowrap font-mono text-[0.7rem] uppercase tracking-[0.28em] text-white/55">
          {townLine} · {townLine}
        </p>
      </div>
    </section>

    <section class="section-padding">
      <div class="container-narrow">
        <div class="mb-10 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="eyebrow mb-3" data-reveal>Past projects</p>
            <h2 class="font-display text-3xl font-extrabold md:text-4xl" data-reveal>Houses, sites, churches</h2>
          </div>
          <a href="/gallery" class="text-sm font-semibold text-rust hover:underline" data-reveal>Full gallery</a>
        </div>
        <div class="grid grid-cols-2 gap-3 md:grid-cols-3">
          {
            homeGalleryPreview.map((item) => (
              <a href="/gallery" class="group relative block aspect-[4/3] overflow-hidden bg-steel" data-reveal>
                <img src={item.src} alt={item.alt} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
                <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/80 to-transparent p-3 font-mono text-[0.65rem] uppercase tracking-widest text-white">
                  {item.project}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-padding bg-panel">
      <div class="container-narrow">
        <p class="eyebrow mb-3" data-reveal>Google reviews</p>
        <h2 class="mb-10 font-display text-3xl font-extrabold md:text-4xl" data-reveal>What the job left behind</h2>
        <div class="grid gap-6 md:grid-cols-2">
          {
            testimonials.map((t) => (
              <figure class="relative border border-hairline bg-galvanised p-6 pt-8" data-reveal>
                <InspectionTag
                  header={t.header}
                  status="Verified review"
                  date="Recent"
                  inspector={t.name}
                  variant="amber"
                  class="absolute -top-5 right-4 hidden sm:block"
                />
                <blockquote class="max-w-prose text-sm leading-relaxed text-ink md:text-base">“{t.quote}”</blockquote>
                <figcaption class="mt-5 font-mono text-[0.7rem] uppercase tracking-widest text-muted">
                  {t.name} · {t.attribution}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-padding">
      <div class="container-narrow" data-reveal>
        <p class="eyebrow mb-3">Service area</p>
        <h2 class="mb-6 font-display text-3xl font-extrabold md:text-4xl">Based in Beccles. Covering the coast and inland.</h2>
        <p class="mb-8 max-w-2xl text-muted">
          Out of Ellough Industrial Estate, working across Suffolk, Norfolk and into Essex — from Southwold and Lowestoft through Norwich, Woodbridge and Ipswich.
        </p>
        <ul class="flex flex-wrap gap-2">
          {
            townLine.split(' · ').map((place) => (
              <li class="border border-hairline bg-panel px-3 py-1.5 font-mono text-[0.7rem] uppercase tracking-wider">{place}</li>
            ))
          }
        </ul>
      </div>
    </section>

    <CtaBand />
  </PageShell>
</Layout>
