---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import CtaBand from '../components/CtaBand.astro';
import { contacts, credentials, site } from '../data/site';
---

<Layout title="About & Safety | East Coast Scaffolding Ltd" description="Beccles scaffolding contractor with CISRS-trained operatives, CITB training, full liability insurance and a health & safety policy reviewed annually.">
  <PageShell>
    <section class="section-padding bg-ink pt-28 text-white">
      <div class="container-narrow max-w-3xl">
        <p class="eyebrow mb-3 text-tag-amber" data-reveal>About &amp; safety</p>
        <h1 class="mb-4 font-display text-4xl font-extrabold text-white md:text-5xl" data-reveal>A Beccles firm that still turns up on the date we gave you</h1>
        <p class="text-lg text-white/75" data-reveal>
          East Coast Scaffolding Ltd works out of Ellough Industrial Estate. The crews cover Norfolk and Suffolk — houses, commercial sites, and the church and heritage jobs that need a careful tie-in.
        </p>
      </div>
    </section>

    <section class="section-padding">
      <div class="container-narrow grid gap-12 lg:grid-cols-2">
        <div data-reveal>
          <h2 class="mb-4 font-display text-2xl font-extrabold">The company</h2>
          <div class="space-y-4 text-muted leading-relaxed">
            <p>
              We are a trade contractor, not a national hire desk. Quotes are priced for the building in front of us: traditional tube-and-fitting, the sheeting or temporary roof if the weather demands it, and a strike date we can actually meet.
            </p>
            <p>
              Combined, our employees have over sixty years in the industry. That shows up in the small things clients write about — arriving when we said, striking the next day when asked, and leaving the ground clean.
            </p>
            <p>
              Homeowners use us for roof and render access. Builders and site managers bring us onto commercial and industrial jobs. Churches and heritage buildings are a regular part of the book — flint towers and stone facades need a scaffold that respects the structure.
            </p>
          </div>
        </div>
        <div class="border border-hairline bg-panel p-6 md:p-8" data-reveal>
          <h2 class="mb-4 font-display text-2xl font-extrabold">Health &amp; safety</h2>
          <p class="mb-6 text-sm leading-relaxed text-muted">
            Safe working conditions are the job, not a slogan. We work to current legislation, keep operatives CITB-trained and CISRS-carded, and review the health and safety policy every year so it matches how the sites actually run.
          </p>
          <ul class="space-y-3">
            {
              credentials.map((c) => (
                <li class="flex gap-3 font-mono text-xs uppercase tracking-wider">
                  <span class="mt-1 h-2 w-2 shrink-0 bg-moss"></span>
                  {c}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="section-padding bg-panel">
      <div class="container-narrow">
        <p class="eyebrow mb-3" data-reveal>Contacts</p>
        <h2 class="mb-8 font-display text-3xl font-extrabold" data-reveal>Who you speak to</h2>
        <div class="grid gap-6 md:grid-cols-2">
          {
            contacts.map((c) => (
              <article class="border border-hairline bg-galvanised p-6" data-reveal>
                <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-moss">{c.role}</p>
                <h3 class="mt-2 font-display text-2xl font-extrabold">{c.name}</h3>
                <a href={c.phoneHref} class="mt-3 inline-block text-lg font-semibold text-rust hover:underline">
                  {c.phone}
                </a>
              </article>
            ))
          }
        </div>
        <p class="mt-8 text-sm text-muted" data-reveal>
          Email <a href={site.emailHref} class="text-ink underline decoration-rust/40 hover:text-rust">{site.email}</a>
          · {site.address}
        </p>
      </div>
    </section>

    <CtaBand />
  </PageShell>
</Layout>
