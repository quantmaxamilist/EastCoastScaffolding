---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
---

<Layout title="Services | East Coast Scaffolding Ltd" description="Traditional scaffolding, temporary roofs, sheeting, hoists, loading bays, EWI access and bespoke scaffold design across Norfolk and Suffolk.">
  <PageShell>
    <section class="section-padding bg-ink pt-28 text-white">
      <div class="container-narrow">
        <p class="eyebrow mb-3 text-tag-amber" data-reveal>Services</p>
        <h1 class="mb-4 font-display text-4xl font-extrabold text-white md:text-5xl" data-reveal>What we erect</h1>
        <p class="max-w-2xl text-lg text-white/75" data-reveal>
          Tube, fittings and boards first. Then the extras the programme actually needs — roofs, sheeting, hoists, loading bays and a drawing if the structure isn’t standard.
        </p>
      </div>
    </section>

    <section class="section-padding">
      <div class="container-narrow space-y-px bg-hairline">
        {
          services.map((s) => (
            <article id={s.slug} class="scroll-mt-28 bg-galvanised p-6 md:p-8" data-reveal>
              <div class="grid gap-6 md:grid-cols-[auto_1fr] md:items-start">
                <span class="inline-flex text-moss">
                  <ServiceIcon name={s.slug} class="h-12 w-12" />
                </span>
                <div>
                  <h2 class="mb-2 font-display text-2xl font-extrabold">{s.title}</h2>
                  <p class="mb-3 max-w-prose text-ink">{s.summary}</p>
                  <p class="max-w-prose text-sm leading-relaxed text-muted">{s.detail}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <CtaBand />
  </PageShell>
</Layout>
