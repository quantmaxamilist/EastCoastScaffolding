---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import PageHeader from '../components/PageHeader.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
---

<Layout title="Services | East Coast Scaffolding Ltd" description="Traditional scaffolding, temporary roofs, sheeting, hoists, loading bays, EWI access and bespoke scaffold design across Norfolk and Suffolk.">
  <PageShell>
    <PageHeader
      eyebrow="Services"
      title="What we erect"
      lede="Tube, fittings and boards first. Then the extras the programme actually needs — roofs, sheeting, hoists, loading bays and a drawing if the structure isn’t standard."
    />

    <section class="section-padding">
      <div class="container-narrow space-y-px bg-hairline">
        {
          services.map((s) => (
            <article id={s.slug} class="scroll-mt-28 bg-galvanised p-6 md:p-8" data-reveal>
              <div class="grid gap-6 md:grid-cols-[auto_1fr] md:items-start">
                <span class="inline-flex text-rust">
                  <ServiceIcon name={s.slug} class="h-12 w-12" />
                </span>
                <div>
                  <h2 class="mb-2 font-display text-2xl font-extrabold">{s.title}</h2>
                  <p class="mb-3 max-w-prose text-ink">{s.summary}</p>
                  <p class="max-w-prose text-sm leading-relaxed text-muted">{s.detail}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <CtaBand />
  </PageShell>
</Layout>
