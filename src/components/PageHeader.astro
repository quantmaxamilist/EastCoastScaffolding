---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  constrain?: boolean;
}

const { eyebrow, title, lede, constrain = false } = Astro.props;
---

<section class="section-padding bg-rust text-white">
  <div class:list={['container-narrow', constrain && 'max-w-3xl']}>
    <p class="eyebrow mb-3 text-white" data-reveal>{eyebrow}</p>
    <h1 class="mb-4 font-display text-4xl font-extrabold text-white md:text-5xl" data-reveal>{title}</h1>
    {
      lede && (
        <p class="max-w-2xl text-lg text-white" data-reveal>
          {lede}
        </p>
      )
    }
  </div>
</section>
