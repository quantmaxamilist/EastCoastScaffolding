---
import { navLinks, site } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-logo-green text-ink transition-shadow [&.scrolled]:shadow-md"
>
  <div class="container-narrow flex items-center justify-between gap-4 py-2 pl-5 pr-5 md:pl-6 md:pr-8 lg:pl-6 lg:pr-12">
    <a href="/" class="block shrink-0 lg:-ml-2" aria-label={`${site.name} — Home`}>
      <img
        src="/logo.png"
        alt=""
        width="952"
        height="414"
        class="block h-[4.75rem] w-auto object-contain md:h-[7.5rem] lg:h-[9.375rem]"
      />
      <span class="sr-only">{site.name}</span>
    </a>

    <div class="flex items-center gap-6 lg:gap-9">
      <nav class="hidden items-center gap-8 lg:flex" aria-label="Main navigation">
        {
          navLinks.map((link) => {
            const active = currentPath === link.href;
            return (
              <a
                href={link.href}
                class:list={[
                  'nav-link relative inline-flex h-11 items-center text-sm font-medium text-ink/85 transition-colors hover:text-ink',
                  'after:absolute after:inset-x-0 after:bottom-[0.6rem] after:h-[2px] after:origin-left after:scale-x-0 after:bg-rust after:transition-transform after:duration-300 after:ease-out hover:after:scale-x-100 focus-visible:after:scale-x-100',
                  active && 'font-semibold text-ink after:scale-x-100',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <div class="flex items-center gap-4">
        <a href={site.phoneHref} class="hidden h-11 items-center font-mono text-xs tracking-wide text-ink/80 transition-colors hover:text-ink md:inline-flex">
          {site.phone}
        </a>
        <a href="/contact" class="btn-primary hidden text-sm sm:inline-flex">{site.ctaPrimary}</a>
        <button
          type="button"
          id="nav-toggle"
          class="nav-toggle relative z-[70] flex h-10 w-10 items-center justify-center rounded-[2px] border border-ink/25 lg:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="nav-toggle__bar bg-ink"></span>
          <span class="nav-toggle__bar bg-ink"></span>
          <span class="nav-toggle__bar bg-ink"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu fixed inset-0 z-[100] lg:hidden" aria-hidden="true" inert>
  <button type="button" id="mobile-menu-backdrop" class="mobile-menu__backdrop absolute inset-0 bg-ink/70" aria-label="Close menu" tabindex="-1"></button>
  <div
    id="mobile-menu-panel"
    class="mobile-menu__panel absolute inset-x-0 top-0 flex max-h-full flex-col bg-logo-green text-ink shadow-2xl"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
  >
    <div class="flex items-center justify-between border-b border-ink/15 px-5 py-4">
      <span class="font-display text-sm tracking-widest text-ink">Menu</span>
      <button type="button" id="mobile-menu-close" class="flex h-10 w-10 items-center justify-center rounded-[2px] border border-ink/20 text-ink" aria-label="Close menu">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <nav class="flex-1 overflow-y-auto px-5 py-4">
      <ul class="flex flex-col gap-1">
        <li><a href="/" class="flex min-h-11 items-center px-3 text-lg font-semibold text-ink hover:text-ink/70" data-mobile-nav-link>Home</a></li>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="flex min-h-11 items-center px-3 text-lg font-semibold text-ink hover:text-ink/70" data-mobile-nav-link>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 space-y-3 border-t border-ink/15 pt-6">
        <a href="/contact" class="btn-primary flex w-full justify-center" data-mobile-nav-link>{site.ctaPrimary}</a>
        <a href={site.phoneHref} class="btn-ghost flex w-full justify-center" data-mobile-nav-link>{site.ctaSecondary}</a>
      </div>
    </nav>
  </div>
</div>

<style>
  .nav-toggle__bar { position: absolute; left: 50%; width: 1.25rem; height: 2px; transform: translateX(-50%); transition: transform .3s, opacity .3s, top .3s; }
  .nav-toggle__bar:nth-child(1) { top: calc(50% - 6px); }
  .nav-toggle__bar:nth-child(2) { top: 50%; transform: translate(-50%, -50%); }
  .nav-toggle__bar:nth-child(3) { top: calc(50% + 6px); }
  .nav-toggle.is-open .nav-toggle__bar:nth-child(1) { top: 50%; transform: translate(-50%, -50%) rotate(45deg); }
  .nav-toggle.is-open .nav-toggle__bar:nth-child(2) { opacity: 0; }
  .nav-toggle.is-open .nav-toggle__bar:nth-child(3) { top: 50%; transform: translate(-50%, -50%) rotate(-45deg); }
  .mobile-menu { visibility: hidden; pointer-events: none; }
  .mobile-menu__backdrop { opacity: 0; transition: opacity .3s; }
  .mobile-menu__panel { opacity: 0; transform: translateY(-12px); transition: opacity .3s, transform .3s; max-height: 100dvh; }
  .mobile-menu.is-open { visibility: visible; pointer-events: auto; }
  .mobile-menu.is-open .mobile-menu__backdrop { opacity: 1; }
  .mobile-menu.is-open .mobile-menu__panel { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .nav-toggle__bar,
    .mobile-menu__backdrop,
    .mobile-menu__panel {
      transition: none;
    }
  }
</style>
