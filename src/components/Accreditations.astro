---
import { accreditationsGraphic } from '../data/site';

interface Props {
  variant?: 'strip' | 'inline';
}

const { variant = 'strip' } = Astro.props;
const isStrip = variant === 'strip';
const imgClass = isStrip
  ? 'h-auto max-h-16 w-auto max-w-full object-contain md:max-h-20'
  : 'h-auto max-h-14 w-auto max-w-full object-contain';
---

{
  isStrip ? (
    <section class="border-t border-hairline bg-galvanised" aria-label="Accreditations">
      <div class="container-narrow flex justify-center px-5 py-8 md:px-8 lg:px-12">
        <img
          src={accreditationsGraphic.src}
          alt={accreditationsGraphic.alt}
          width={accreditationsGraphic.width}
          height={accreditationsGraphic.height}
          class={imgClass}
        />
      </div>
    </section>
  ) : (
    <img
      src={accreditationsGraphic.src}
      alt={accreditationsGraphic.alt}
      width={accreditationsGraphic.width}
      height={accreditationsGraphic.height}
      class={imgClass}
    />
  )
}
