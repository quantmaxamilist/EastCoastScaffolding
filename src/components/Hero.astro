---
import InspectionTag from './InspectionTag.astro';
import { site } from '../data/site';
---

<section class="relative flex min-h-[100svh] items-end overflow-hidden bg-ink text-white">
  <img
    src="/best.jpg"
    alt="Looking out through a tube-and-fitting scaffold at sunrise over open Suffolk fields."
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-ink/88 via-ink/55 to-ink/15"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-ink/25"></div>

  <div class="hero-rig pointer-events-none absolute inset-y-0 left-0 hidden w-[42%] md:block" aria-hidden="true">
    <span class="hero-pole-v absolute bottom-0 left-[12%] top-[8%] w-px bg-white/35"></span>
    <span class="hero-pole-v absolute bottom-0 left-[28%] top-[14%] w-px bg-white/30"></span>
    <span class="hero-pole-v absolute bottom-0 left-[44%] top-[10%] w-px bg-white/25"></span>
    <span class="hero-pole-v absolute bottom-[12%] left-[60%] top-[22%] w-px bg-white/20"></span>
    <span class="hero-pole-h absolute left-[8%] right-[32%] top-[28%] h-px bg-white/25"></span>
    <span class="hero-pole-h absolute left-[8%] right-[28%] top-[46%] h-px bg-white/30"></span>
    <span class="hero-pole-h absolute left-[8%] right-[36%] top-[64%] h-px bg-white/22"></span>
    <span class="hero-pole-h absolute left-[12%] w-[18%] top-[46%] h-[7px] bg-white/15"></span>
    <span class="hero-pole-h absolute left-[28%] w-[16%] top-[28%] h-[7px] bg-white/12"></span>
  </div>

  <div class="relative z-10 w-full section-padding pb-16 pt-32 md:pb-20">
    <div class="container-narrow grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-10">
      <div class="hero-copy max-w-3xl">
        <p class="eyebrow mb-4 text-tag-amber">Beccles · Norfolk &amp; Suffolk</p>
        <h1 class="mb-6 max-w-4xl font-display text-4xl font-extrabold leading-[1.05] text-white md:text-6xl lg:text-7xl">
          Erected right.<br />Struck on time.
        </h1>
        <p class="mb-8 max-w-xl text-base leading-relaxed text-white/80 md:text-lg">
          Traditional scaffolding for homeowners, contractors and heritage jobs. CISRS-trained crews, full insurance, and a site left clean when we strike.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href="/contact" class="btn-primary">{site.ctaPrimary}</a>
          <a href={site.phoneHref} class="btn-ghost-light">{site.ctaSecondary}</a>
        </div>
      </div>
      <InspectionTag
        tagNumber="ECS-001"
        header="Scaffold tag"
        status="CISRS trained, fully insured"
        date="Live"
        inspector="ECS"
        variant="rust"
        size="hero"
        stamp
        class="hero-tag"
      />
    </div>
  </div>
</section>
